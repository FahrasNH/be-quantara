# ── Canary live runner (scripts/canary.js) ──────────────────────────────────
# Salin ke .env.canary lalu jalankan:
#   export $(grep -v '^#' .env.canary | xargs) && npm run canary
# atau inline:
#   CANARY_EMAIL=... CANARY_PASSWORD=... npm run canary
#
# PRASYARAT:
#   - Backend sudah jalan (npm start) & bisa diakses dari CANARY_API_BASE
#   - API key Bitget user SUDAH dikonfigurasi di Settings (TANPA permission withdraw,
#     IP whitelist aktif) dan margin mode sesuai
#   - Akun exchange BERISI MODAL KECIL (canary menolak jalan bila equity > guard)

CANARY_API_BASE=http://localhost:3000
CANARY_EMAIL=
CANARY_PASSWORD=

CANARY_SYMBOL=BTCUSDT
CANARY_STRATEGY=ADAPTIVE_FUSION
CANARY_CAPITAL=20

# HARD GUARD — canary ABORT bila equity akun lebih besar dari ini (cegah salah akun)
CANARY_MAX_ACCOUNT_USDT=100

# Auto-stop bila drawdown dari equity awal ≥ nilai ini (0.05 = 5%)
CANARY_MAX_DRAWDOWN_PCT=0.05

CANARY_POLL_SEC=60
CANARY_DURATION_HOURS=24

# true = canary yang start bot (LIVE). false = hanya memonitor bot yang sudah jalan.
CANARY_AUTOSTART=true
CANARY_STOP_ON_DRAWDOWN=true

# (Opsional) Alert Telegram — bila diisi, canary kirim START/STOP/ALERT/SUMMARY
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
