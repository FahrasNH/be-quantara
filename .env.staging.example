# ═══════════════════════════════════════════════════════════════════════════
# .env.staging — Quantara Backend (STAGING, VPS port 3001)
# Salin ke `.env` di /opt/quantara-staging/be pada VPS staging.
# Generate secrets: openssl rand -hex 48 (JWT) | openssl rand -hex 32 (ENCRYPTION_KEY)
# ═══════════════════════════════════════════════════════════════════════════

# ── WAJIB ───────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://quantara_staging:GANTI_PASSWORD@127.0.0.1:5432/bot_trading_staging?schema=public"

JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_48"
JWT_REFRESH_SECRET="GANTI_DENGAN_HASIL_BERBEDA_openssl_rand_hex_48"
ENCRYPTION_KEY="GANTI_DENGAN_HASIL_openssl_rand_hex_32"

NODE_ENV="production"

# ── SERVER ──────────────────────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"

# ── CORS ────────────────────────────────────────────────────────────────────
# Frontend staging di nginx port 443 HTTPS (staging.quantara.software)
CORS_ORIGINS="https://staging.quantara.software"

TRUST_PROXY_HOPS=1

# Public URL of the frontend — used in verification & password-reset links in emails.
APP_URL="https://staging.quantara.software"

# Email (WAJIB untuk verifikasi akun & reset password)
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USER="notifications@yourdomain.com"
# EMAIL_PASS="your-16-char-app-password"

# ── TELEGRAM (opsional — gunakan chat ID berbeda dari production) ───────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# Batasi exchange yang bisa dihubungkan. Kosong = semua exchange diizinkan.
ALLOWED_EXCHANGES=bitget,okx,binance

# ── CATATAN STAGING ─────────────────────────────────────────────────────────
# • Database terpisah dari production (bot_trading_staging).
# • JWT & ENCRYPTION_KEY HARUS berbeda dari production.
# • Default mode bot: Dry Run (via UI, bukan env).
# • Deploy BE: scripts/deploy-staging-vps.sh (atau deploy-staging.sh dari fe-bot-trading)

# ── PROFILING (staging) ─────────────────────────────────────────────────────
# Cetak RSS/heap tiap 30 detik di pm2 logs — bantu deteksi memory leak saat scale test.
MEM_DEBUG=1
