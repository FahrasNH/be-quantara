# ─────────────────────────────────────────────
# .env — Backend Configuration
# ─────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FE_URL=https://fe-quantara.vercel.app/

# Exchange (bitget atau okx)
EXCHANGE=bitget

# Strategi Trading
# A = Aggressive Scalping    (banyak trade, EMA 3/8, RSI reversal)
# B = Momentum Breakout      (balance, EMA 5/13, RSI momentum) ← RECOMMENDED
# C = Multi-Timeframe Pro    (akurat, 15m filter + 5m entry)
STRATEGY=B

# Bitget API Keys
BITGET_API_KEY=bg_a6b9b98b950058f6c6580d3f1a145828
BITGET_SECRET_KEY=ca6aec1fb43a3ceb1f6e2e21f9f8434114d08efc446c8a9a7eb212fb5f58e66a
BITGET_PASSPHRASE=TradingBot2026

# OKX API Keys (jika pakai OKX)
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO_TRADING=true

# Default Trading Parameters
# Gunakan SYMBOLS untuk multi-bot (max 3, pisahkan dengan koma)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOL=BTCUSDT
MARGIN_COIN=USDT
PRODUCT_TYPE=umcbl
CANDLE_INTERVAL=5m
CHECK_INTERVAL_MS=60000

# Technical Indicators
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=65
RSI_OVERSOLD=35
ATR_PERIOD=14
ATR_MULTIPLIER=2

# Risk Management
LEVERAGE=2
RISK_REWARD=3
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=1
USE_BOTH_SIDES=true

# Logging
LOG_LEVEL=info
DRY_RUN=false

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
