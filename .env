# ─────────────────────────────────────────────
# .env — Backend Configuration
# ─────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FE_URL=http://localhost:5173

# Exchange (bitget atau okx)
EXCHANGE=bitget

# Bitget API Keys
BITGET_API_KEY=bg_a6b9b98b950058f6c6580d3f1a145828
BITGET_SECRET_KEY=ca6aec1fb43a3ceb1f6e2e21f9f8434114d08efc446c8a9a7eb212fb5f58e66a
BITGET_PASSPHRASE=TradingBot2026

# OKX API Keys (jika pakai OKX)
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO_TRADING=true

# Default Trading Parameters
SYMBOL=BTCUSDT
MARGIN_COIN=USDT
PRODUCT_TYPE=umcbl
CANDLE_INTERVAL=4H
CHECK_INTERVAL_MS=60000

# Technical Indicators
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_MULTIPLIER=2

# Risk Management
LEVERAGE=3
RISK_REWARD=3
RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=1
USE_BOTH_SIDES=false

# Logging
LOG_LEVEL=info
DRY_RUN=true

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
