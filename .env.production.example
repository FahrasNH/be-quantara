# ═══════════════════════════════════════════════════════════════════════════
# .env.production — Quantara Backend (PRODUCTION)
# Salin ke `.env` di server produksi, lalu ISI semua nilai WAJIB di bawah.
# Server akan REFUSE TO START (cfg.validate) jika ada yang kosong / placeholder.
# ═══════════════════════════════════════════════════════════════════════════

# ── WAJIB ───────────────────────────────────────────────────────────────────

# Koneksi PostgreSQL produksi (JANGAN expose port DB ke publik)
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/bot_trading?schema=public"

# Secrets JWT — WAJIB diganti, tidak boleh placeholder, tidak boleh sama.
# Generate masing-masing: openssl rand -hex 48
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_48"
JWT_REFRESH_SECRET="GANTI_DENGAN_HASIL_BERBEDA_openssl_rand_hex_48"

# Kunci enkripsi API key user (32 byte / 64 hex char).
# Generate: openssl rand -hex 32
# PENTING: jika diganti, semua API key user tersimpan jadi tidak bisa didekripsi.
ENCRYPTION_KEY="GANTI_DENGAN_HASIL_openssl_rand_hex_32"

# Wajib "production" agar rate-limit ketat & validasi placeholder aktif.
NODE_ENV="production"

# ── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
HOST="0.0.0.0"

# ── CORS ────────────────────────────────────────────────────────────────────
# Domain frontend yang diizinkan (comma-separated, TANPA trailing slash).
# Localhost otomatis diizinkan terpisah — tidak perlu ditulis di sini.
# Ganti ke domain HTTPS begitu domain & TLS siap.
CORS_ORIGINS="http://187.77.135.156"

# ── RATE LIMIT ──────────────────────────────────────────────────────────────
# Max POST login/register per 15 menit per IP. Default production: 10.
# AUTH_RATE_LIMIT=10

# Max request per 15 menit per IP untuk semua endpoint /api/v1 (selain auth).
# Dashboard real-time butuh polling — default 1000 sudah cukup untuk 1 user
# beberapa tab. Naikkan bila perlu.
# API_RATE_LIMIT=1000

# ── TRUST PROXY (WAJIB di belakang nginx) ───────────────────────────────────
# Jumlah hop reverse-proxy. 1 = satu nginx di depan app.
# TANPA ini, rate limit dihitung per-IP nginx → semua user kena 429 bersama.
TRUST_PROXY_HOPS=1

# ── TELEGRAM (opsional) ─────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── EXCHANGE FALLBACK (opsional) ────────────────────────────────────────────
# Kredensial utama disimpan per-user (terenkripsi) di DB via Settings.
# Variabel di bawah hanya fallback bila user belum mengisi key di UI.
# BITGET_API_KEY=""
# BITGET_SECRET_KEY=""
# BITGET_PASSPHRASE=""

# ── CATATAN PRODUCTION ──────────────────────────────────────────────────────
# • Mode trading (Live / Dry Run) BUKAN env var. Dipilih per-bot lewat UI dan
#   disimpan di DB. Tidak ada lagi flag DRY_RUN di .env.
# • Jalankan `npx prisma migrate deploy` sebelum start (bukan `db push`).
# • Pastikan HTTPS aktif di reverse proxy (nginx) sebelum go-live.
