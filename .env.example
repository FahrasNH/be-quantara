# ─────────────────────────────────────────────
# EXCHANGE SELECTOR
# Pilih exchange yang digunakan: bitget | okx
# ─────────────────────────────────────────────
EXCHANGE=bitget                 # "bitget" atau "okx"

# ─────────────────────────────────────────────
# BITGET API CREDENTIALS
# Buat di: Bitget → User Center → API Management
# Permission: READ + TRADE (jangan centang Withdraw!)
# ─────────────────────────────────────────────
BITGET_API_KEY=bg_a6b9b98b950058f6c6580d3f1a145828
BITGET_SECRET_KEY=ca6aec1fb43a3ceb1f6e2e21f9f8434114d08efc446c8a9a7eb212fb5f58e66a
BITGET_PASSPHRASE=TradingBot2026

# ─────────────────────────────────────────────
# OKX API CREDENTIALS
# Buat di: OKX → Profile → API Management → Create V5 API
# Permission: READ + TRADE (jangan centang Withdraw!)
# Demo: aktifkan "Demo Trading" di OKX website
# ─────────────────────────────────────────────
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO_TRADING=true           # true = Paper Trading (aman), false = Live
OKX_INST_ID=BTC-USDT-SWAP      # Format OKX: BASE-QUOTE-SWAP

# ─────────────────────────────────────────────
# TRADING CONFIG
# ─────────────────────────────────────────────
SYMBOL=BTCUSDT                  # Bitget symbol (diabaikan jika EXCHANGE=okx)
MARGIN_COIN=USDT                # Margin currency
PRODUCT_TYPE=umcbl              # umcbl = USDT-M Futures (Bitget only)

# ─────────────────────────────────────────────
# STRATEGY PARAMETERS
# ─────────────────────────────────────────────
EMA_FAST=9                      # EMA periode cepat
EMA_SLOW=21                     # EMA periode lambat
RSI_PERIOD=14                   # RSI periode
RSI_OVERBOUGHT=70               # Batas overbought (filter LONG)
RSI_OVERSOLD=30                 # Batas oversold (filter SHORT)
ATR_PERIOD=14                   # ATR periode
ATR_MULTIPLIER=2                # SL = ATR_MULT × ATR
RISK_REWARD=3                   # TP = RISK_REWARD × SL distance

# ─────────────────────────────────────────────
# RISK MANAGEMENT
# ─────────────────────────────────────────────
RISK_PER_TRADE=0.02             # 2% modal per trade
MAX_OPEN_POSITIONS=1            # Maksimal posisi sekaligus
LEVERAGE=3                      # Leverage (hati-hati!)
USE_BOTH_SIDES=false            # true = LONG dan SHORT, false = LONG only

# ─────────────────────────────────────────────
# TIMEFRAME & INTERVALS
# ─────────────────────────────────────────────
CANDLE_INTERVAL=4H              # 1H, 4H, 1D
CHECK_INTERVAL_MS=60000         # Cek setiap 60 detik

# ─────────────────────────────────────────────
# NOTIFICATIONS (opsional)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # Kosongkan jika tidak pakai
TELEGRAM_CHAT_ID=               # Kosongkan jika tidak pakai

# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
DRY_RUN=true                    # true = simulasi (tidak order beneran), false = live trading
LOG_LEVEL=info                  # debug, info, warn, error
