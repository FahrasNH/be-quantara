# Database Configuration
# For development (local PostgreSQL)
# DATABASE_URL="postgresql://bottrading:bottrading_dev@localhost:5433/bot_trading?schema=public"

# For production/VPS (replace with your VPS details)
# DATABASE_URL="postgresql://bottrading:bottrading_dev@VPS_IP:5432/bot_trading?schema=public"

# Authentication Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"

# Encryption Key — WAJIB generate sendiri, JANGAN pakai nilai contoh apa pun.
# Generate: openssl rand -hex 32
# (Dipakai untuk enkripsi AES-256-GCM API key exchange. Ganti = semua key
#  tersimpan tak bisa didekripsi, jadi set sekali lalu jangan diubah.)
ENCRYPTION_KEY="<generate-with: openssl rand -hex 32>"

# Environment
NODE_ENV="development"
PORT=3000

# CORS — domain frontend yang diizinkan (comma-separated, tanpa trailing slash).
# Localhost selalu diizinkan otomatis. Production: lihat .env.production.example
# CORS_ORIGINS="http://187.77.135.156"

# Rate limiting — jumlah max POST login/register per 15 menit per IP
# Default production: 10, development: 100
# Naikkan angka ini saat testing, turunkan di production untuk keamanan
# AUTH_RATE_LIMIT=20

# API_RATE_LIMIT — max request per 15 menit per IP untuk SEMUA endpoint /api/v1
# (selain auth). Dashboard real-time butuh polling, jadi default tinggi (1000).
# Naikkan bila banyak tab/aktivitas. Wajib bersama TRUST_PROXY_HOPS di belakang nginx.
# API_RATE_LIMIT=1000

# TRUST_PROXY_HOPS — jumlah hop reverse-proxy di depan app (1 = satu nginx).
# WAJIB di production agar rate limit dihitung per-IP user, bukan per-IP nginx.
# Salah set → semua user berbagi satu bucket → 429 massal.
# TRUST_PROXY_HOPS=1

# ── Telegram Notifications (opsional) ────────────────────────────────────────
# Otomatis NONAKTIF saat NODE_ENV=development (tidak kirim notif saat dev lokal).
# Aktif di staging/production selama kedua variabel diisi.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── Exchange API Key (FALLBACK saja — opsional) ──────────────────────────────
# Kredensial utama disimpan per-user di database via halaman Settings.
# Variabel di bawah hanya dipakai jika user belum mengkonfigurasi key di UI.
# BITGET_API_KEY=""
# BITGET_SECRET_KEY=""
# BITGET_PASSPHRASE=""

# xAI Grok — https://console.x.ai/
# XAI_ENABLED=true
# XAI_API_KEY=""
# XAI_MODEL="grok-4.3"
# XAI_OPTIMIZER_OPEN=true
# Opsional RAG: XAI_MANAGEMENT_API_KEY, XAI_COLLECTION_ID (lihat docs/XAI_SETUP.md)

# Grok AI Live Trading (strategi GROK_AI_TRADING — lihat docs/XAI_SETUP.md)
# GROK_TRADING_ENABLED=true
# GROK_TRADING_MIN_CONFIDENCE_ENTRY=8
# GROK_TRADING_MIN_CONFIDENCE_TP_SL=7
# GROK_TRADING_MAX_TOKENS=2000
# GROK_TRADING_TEMPERATURE=0.3
# GROK_TRADING_CYCLE_MS=600000
# GROK_TRADING_DRY_RUN=true
# GROK_TRADING_LOG_INTERACTIONS=true
# GROK_TRADING_OPEN=true

# Grok Confirm Gate — Mode B (AF/TM/MR/BR — lihat docs/XAI_SETUP.md)
# GROK_CONFIRM_ENABLED=true
# GROK_CONFIRM_MIN_CONFIDENCE_ENTRY=8
# GROK_CONFIRM_MIN_TP_CONFIDENCE=7
# GROK_CONFIRM_MIN_TP_MODE_CONFIDENCE=6
# GROK_CONFIRM_TP_ADJUST_BAND_PCT=15
# GROK_CONFIRM_TP_MAX_ATR_MULT=0.5
# GROK_CONFIRM_TP_REJECT_ACTION=skip
# GROK_CONFIRM_FAIL_MODE=closed
# GROK_CONFIRM_PROMPT_LITE=true
# GROK_CONFIRM_OPEN=true

# ── ML Data Readiness / Win Gate (Sprint 16) ─────────────────────────────────
# Pre-trade win-probability gate (BotEngine + AdaptiveStrategyEngine).
# ML_GATE_MODE=shadow   — log only, never block (default, safe for prod rollout)
# ML_GATE_MODE=active   — skip entry when pWin < threshold
# ML_GATE_MODE=disabled — bypass ML gate entirely
# ML_GATE_MODE=shadow
# ML_WIN_GATE_THRESHOLD=0.45
# Closed trades below this count use regime confidence defaults instead of WinPredictor.
# ML_COLD_START_TRADES=200

# ── CATATAN ──────────────────────────────────────────────────────────────────
# Konfigurasi trading (dry-run, strategy, capital, leverage, EMA/RSI/ATR, dll)
# TIDAK lagi diatur di .env. Sumbernya:
#   • Parameter teknikal → src/domain/legacyStrategies.js
#   • Pilihan per-bot     → database (dipilih lewat UI/Settings)
