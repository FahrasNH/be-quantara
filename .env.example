# ─────────────────────────────────────────────
# .env.example — Quantara Backend Configuration
# Salin file ini: cp .env.example .env
# Lalu isi dengan nilai yang benar
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FE_URL=http://localhost:5173          # Ganti dengan URL FE di produksi

# ── Exchange ─────────────────────────────────
EXCHANGE=bitget                       # "bitget" atau "okx"

# ── Bitget API Keys ──────────────────────────
# Buat di: Bitget → User Center → API Management
# Permission: READ + TRADE (jangan centang Withdraw!)
BITGET_API_KEY=your_bitget_api_key
BITGET_SECRET_KEY=your_bitget_secret_key
BITGET_PASSPHRASE=your_bitget_passphrase

# ── OKX API Keys (opsional) ──────────────────
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO_TRADING=true
OKX_INST_ID=BTC-USDT-SWAP

# ── Trading Config ────────────────────────────
SYMBOL=BTCUSDT
MARGIN_COIN=USDT
PRODUCT_TYPE=umcbl
CANDLE_INTERVAL=4H
CHECK_INTERVAL_MS=60000

# ── Strategy Parameters ───────────────────────
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_MULTIPLIER=2
RISK_REWARD=3

# ── Risk Management ───────────────────────────
RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=1
LEVERAGE=3
USE_BOTH_SIDES=false

# ── Mode ──────────────────────────────────────
DRY_RUN=true                          # true = simulasi, false = live trading
LOG_LEVEL=info

# ── Telegram (opsional) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
