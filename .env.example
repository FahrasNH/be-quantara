# Database Configuration
# For development (local PostgreSQL)
# DATABASE_URL="postgresql://bottrading:bottrading_dev@localhost:5433/bot_trading?schema=public"

# For production/VPS (replace with your VPS details)
# DATABASE_URL="postgresql://bottrading:bottrading_dev@VPS_IP:5432/bot_trading?schema=public"

# Authentication Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"

# Encryption Key
ENCRYPTION_KEY="c13aec676c24983a3addcec886a7a2d5df09c85f2adbcb0bd1de0adaa1340754"

# Environment
NODE_ENV="development"
PORT=3000

# Rate limiting — jumlah max POST login/register per 15 menit per IP
# Default production: 10, development: 100
# Naikkan angka ini saat testing, turunkan di production untuk keamanan
# AUTH_RATE_LIMIT=20

# ── Telegram Notifications (opsional) ────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── Exchange API Key (FALLBACK saja — opsional) ──────────────────────────────
# Kredensial utama disimpan per-user di database via halaman Settings.
# Variabel di bawah hanya dipakai jika user belum mengkonfigurasi key di UI.
# BITGET_API_KEY=""
# BITGET_SECRET_KEY=""
# BITGET_PASSPHRASE=""

# ── CATATAN ──────────────────────────────────────────────────────────────────
# Konfigurasi trading (dry-run, strategy, capital, leverage, EMA/RSI/ATR, dll)
# TIDAK lagi diatur di .env. Sumbernya:
#   • Parameter teknikal → src/domain/strategies.js
#   • Pilihan per-bot     → database (dipilih lewat UI/Settings)
