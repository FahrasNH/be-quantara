{
  "name": "quantara-bot",
  "version": "2.0.0",
  "description": "Quantara — Automated Trading Bot for Bitget",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "prestart": "prisma generate",
    "predev": "prisma generate",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "backtest": "node scripts/backtest.js",
    "canary": "node scripts/canary.js",
    "test": "node test/indicators.test.js && node test/run-strategies.js && node test/AccountCoordinator.test.js && node test/integration-security-risk.test.js && node test/quantara.patches.test.js && node test/SignalConflictResolver.test.js && node test/MultiStrategyCoordinator.test.js && node test/entitlement-strategies.test.js && node test/tierConfig-allocation.test.js && node test/tradeAttribution.test.js",
    "test:patches": "node test/quantara.patches.test.js",
    "test:conflict": "node test/SignalConflictResolver.test.js",
    "test:multi": "node test/MultiStrategyCoordinator.test.js",
    "test:entitlement": "node test/entitlement-strategies.test.js",
    "test:indicators": "node test/indicators.test.js",
    "test:coordinator": "node test/AccountCoordinator.test.js",
    "test:integration": "node test/integration-security-risk.test.js",
    "test:strategies": "node test/run-strategies.js",
    "test:watch": "nodemon test/indicators.test.js",
    "lint": "eslint src index.js server.js",
    "lint:fix": "eslint src index.js server.js --fix",
    "format": "prettier --write \"src/**/*.js\" index.js server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "ccxt": "^4.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prisma": "^6.19.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3"
  }
}
