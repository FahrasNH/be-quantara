# Quantara PRODUCTION — nginx dengan TLS/HTTPS (OPS-002)
# Salin ke VPS: /etc/nginx/sites-available/quantara
# GANTI semua "YOUR_SUBDOMAIN.duckdns.org" dgn domain Anda (mis. quantara.software).
#
# Jalur sertifikat (diisi otomatis oleh certbot --nginx). Bila pakai certbot
# manual, path default: /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/

upstream backend_production {
  server 127.0.0.1:3000;
}

# ── HTTP :80 → redirect ke HTTPS (kecuali ACME challenge certbot) ────────────
server {
  listen 80;
  server_name YOUR_SUBDOMAIN.duckdns.org;

  # Biarkan certbot webroot challenge lewat tanpa redirect
  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── HTTPS :443 ───────────────────────────────────────────────────────────────
server {
  listen 443 ssl http2;
  server_name YOUR_SUBDOMAIN.duckdns.org;

  ssl_certificate     /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/privkey.pem;

  # TLS hardening (Mozilla intermediate)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location /api/v1/backtest/klines {
    proxy_pass http://backend_production;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }

  location /api/ {
    proxy_pass http://backend_production;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
  }

  location /ws {
    proxy_pass http://backend_production;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WS idle bisa lama (bot tick 30s–5m). Tanpa ini default nginx 60s memutus
    # koneksi → FE flicker "Disconnected" + reconnect loop. Samakan dgn staging.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    root /var/www/quantara-prod/fe;
    # Security headers + CSP (wajib per-location, nginx tidak mewarisi add_header).
    # connect-src HARUS mengizinkan wss origin produksi, kalau tidak browser
    # memblokir WebSocket → "Disconnected" walau nginx/BE sehat.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss://quantara.software; frame-ancestors 'none';" always;
    try_files $uri $uri/ /index.html;
  }
}
