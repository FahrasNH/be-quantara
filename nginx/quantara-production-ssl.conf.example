# Quantara PRODUCTION — nginx dengan TLS/HTTPS (OPS-002)
# Salin ke VPS: /etc/nginx/sites-available/quantara
# GANTI semua "YOUR_SUBDOMAIN.duckdns.org" dgn domain DuckDNS Anda.
#
# Jalur sertifikat (diisi otomatis oleh certbot --nginx). Bila pakai certbot
# manual, path default: /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/

upstream backend_production {
  server 127.0.0.1:3000;
}

# ── HTTP :80 → redirect ke HTTPS (kecuali ACME challenge certbot) ────────────
server {
  listen 80;
  server_name YOUR_SUBDOMAIN.duckdns.org;

  # Biarkan certbot webroot challenge lewat tanpa redirect
  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── HTTPS :443 ───────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name YOUR_SUBDOMAIN.duckdns.org;

  ssl_certificate     /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/privkey.pem;

  # TLS hardening (Mozilla intermediate)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location /api/ {
    proxy_pass http://backend_production;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
  }

  location /ws {
    proxy_pass http://backend_production;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    root /var/www/quantara;
    try_files $uri $uri/ /index.html;
  }
}
