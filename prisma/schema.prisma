generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  
  balance      Float    @default(0)
  apiKey       String?
  apiSecret    String?
  apiPassphrase String?
  exchangeType  String?  @default("bitget")
  // HMAC fingerprint of apiKey — unique so the same exchange account
  // cannot be connected by two different users (prevents bot conflicts).
  apiKeyHash    String?  @unique

  // Telegram integration — user memasukkan chat ID dari @quantara_trading_bot
  telegramChatId String?

  bots       Bot[]
  strategies UserStrategy[]
  auditLogs  AuditLog[]
  exchanges  UserExchange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserExchange {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  exchangeType  String
  apiKey        String
  apiSecret     String
  apiPassphrase String?
  apiKeyHash    String   @unique

  label         String?   // future multi-exchange label
  deletedAt     DateTime? // soft-delete flag (null = active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exchangeType])
  @@index([userId])
}

model UserStrategy {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique

  strategyKey String  @default("ADAPTIVE_FUSION")
  balanceTier String  @default("C")
  tier        String  @default("FOUNDRY")
  
  riskPerTrade Float  @default(0.01)
  maxOpenPositions Int @default(1)
  leverage    Int     @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bot {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  symbol    String
  capital   Float    @default(500)
  strategyKey String  @default("ADAPTIVE_FUSION")
  dryRun    Boolean  @default(true)

  // Sprint 4 / WT-4 — per-bot parameter overrides (walk-forward applied params)
  configOverrides Json?

  // ── Multi-Strategy per Coin (Quantara feature) ──────────────────────────
  // strategyGroup: semua strategi tier yang dijalankan serentak pada koin ini.
  // Kosong = mode legacy single-strategy (pakai strategyKey di atas).
  // capitalPerStrategy: capital / jumlah strategi (equal-weight allocation).
  strategyGroup      String[] @default([])
  capitalPerStrategy Float?   @default(0)

  // ── Take-Profit mode ────────────────────────────────────────────────────
  // "full"    → posisi lari ke TP penuh tanpa dipotong (default, reward optimal)
  // "partial" → partial close di +1R/+2R + SL geser ke BEP/+1R (risiko lebih rendah)
  tpMode     String   @default("full")

  running   Boolean  @default(false)
  startedAt DateTime?
  stoppedAt DateTime?
  
  totalTrades    Int     @default(0)
  winningTrades  Int     @default(0)
  losingTrades   Int     @default(0)
  
  trades    Trade[]
  logs      BotLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, symbol])
  @@index([userId])
}

model Trade {
  id        String   @id @default(cuid())
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  botId     String
  
  symbol    String
  side      String
  entry     Float
  exit      Float?
  quantity  Float
  
  pnl       Float?
  pnlPercent Float?

  status    String   @default("OPEN")

  // ── Multi-Strategy attribution (Quantara feature) ───────────────────────
  // firedByStrategy: strategi yang memfire entry ini (untuk atribusi & analitik).
  // slPrice/tpPrice: harga SL/TP aktual yang dihitung saat entry.
  // slMultiplier/tpMultiplier: dari config strategi yang fire (audit trail).
  firedByStrategy String?
  slPrice         Float?
  tpPrice         Float?
  slMultiplier    Float?
  tpMultiplier    Float?

  // ── Feature Store (Sprint 1 / FS-2) ────────────────────────────────────────
  // JSONB blobs capturing full market state at entry and exit for analytics,
  // regime-fitness scoring, and ML feature engineering.
  entryContext Json?
  exitContext  Json?

  enteredAt DateTime @default(now())
  exitedAt  DateTime?

  @@index([botId])
  @@index([status])
}

model BotLog {
  id        String   @id @default(cuid())
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  botId     String
  
  level     String
  message   String
  metadata  String?
  
  createdAt DateTime @default(now())
  
  @@index([botId])
  @@index([level])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  action    String
  resource  String?
  resourceId String?
  
  details   String?
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
}

model Session {
  id        String   @id @default(cuid())
  userId    String

  // Only the bcrypt hash is stored — never the raw token.
  // refreshToken plaintext field removed (P1.3 security hardening).
  refreshTokenHash String?
  userAgent        String?
  ipAddress        String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature Store — Sprint 1 (FS-4)
//
// Daily aggregation of trade performance grouped by
// (strategyKey, symbol, regime, tradeType, pairTier).
// Populated by StrategyPerformanceService.aggregateDaily() via cron at 02:00 UTC.
// ─────────────────────────────────────────────────────────────────────────────
model StrategyPerformance {
  id            String   @id @default(cuid())
  strategyKey   String
  symbol        String
  regime        String
  tradeType     String?
  pairTier      String?
  periodDate    DateTime

  tradeCount     Int   @default(0)
  winCount       Int   @default(0)
  lossCount      Int   @default(0)
  winRate        Float @default(0)
  profitFactor   Float @default(0)
  avgPnlPct      Float @default(0)
  maxDrawdownPct Float @default(0)
  sharpeRatio    Float?
  avgHoldingMs   Float?

  // Sprint 2 / PA-1 additions
  sortino         Float?
  expectancy      Float?
  avgRr           Float?
  avgHoldingHours Float?
  period          String  @default("daily")
  sampleSizeValid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([strategyKey, symbol, regime, tradeType, pairTier, periodDate])
  @@index([strategyKey, symbol])
  @@index([periodDate])
  @@index([period])
}

model PaymentAuditLog {
  id        String  @id @default(cuid())
  paymentId String?
  userId    String?
  orderId   String?

  event     String
  detail    String? // JSON string, never card data
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
  @@index([event])
}

// ── Sprint 3 / MS-1 ──────────────────────────────────────────────────────────

// ── Sprint 4 / WT-1 — Walk-Forward Parameter Tuning ──────────────────────────

model ParameterSuggestion {
  id              String    @id @default(cuid())
  strategyKey     String
  symbol          String
  suggestedParams Json
  currentParams   Json?
  trainMetrics    Json
  validMetrics    Json
  trainDays       Int       @default(90)
  validDays       Int       @default(30)
  sampleSize      Int
  sampleSizeValid Boolean   @default(false)
  status          String    @default("pending") // pending | applied | rejected | expired
  appliedAt       DateTime?
  appliedBy       String?
  rejectedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([strategyKey, symbol])
  @@index([status])
  @@index([createdAt])
}

model ParameterVersion {
  id          String   @id @default(cuid())
  strategyKey String
  symbol      String?
  params      Json
  source      String   @default("manual") // manual | walk_forward | rollback
  appliedAt   DateTime @default(now())
  appliedBy   String?
  previousId  String?
  pnlBefore   Float?
  pnlAfter    Float?
  createdAt   DateTime @default(now())

  @@index([strategyKey, symbol])
  @@index([appliedAt])
}

model MetaSelectorRecommendation {
  id               String   @id @default(cuid())
  symbol           String
  regime           String
  regimeConfidence Float
  mode             String   @default("shadow") // shadow | advisory
  recommendations  Json     // Array<{strategyKey,score,winRate,pf,sharpe,rank}>
  actualStrategy   String?  // strategy actually used by bot (filled by MS-2)
  actualOutcome    String?  // win | loss | pending (filled after trade close)
  tradeId          String?  // linked Trade.id (nullable)

  createdAt DateTime @default(now())

  @@index([symbol, regime])
  @@index([createdAt])
  @@index([mode])
}

// ── Sprint 5 / RL-1 — Trade Embeddings (pgvector) ────────────────────────────
// Note: vector type is not natively supported by Prisma — use Unsupported.
// Actual vector ops are performed via raw pg client in VectorStore.js.
model TradeEmbedding {
  id        String   @id @default(cuid())
  tradeId   String   @unique
  vector    Unsupported("vector(60)")?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tradeId])
  @@index([createdAt])
}

// ── Sprint 5 / RL-4 — ML Shadow Log ──────────────────────────────────────────
model MLShadowLog {
  id            String   @id @default(cuid())
  tradeId       String?
  pWin          Float
  threshold     Float    @default(0.6)
  prediction    String   // 'win' | 'loss' (pWin >= threshold → 'win')
  actualOutcome String?  // filled after trade close
  features      Json?    // optional: feature snapshot
  strategyKey   String?
  symbol        String?
  regime        String?
  createdAt     DateTime @default(now())

  @@index([tradeId])
  @@index([createdAt])
  @@index([strategyKey, symbol])
}
