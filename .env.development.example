# ═══════════════════════════════════════════════════════════════════════════
# .env.development — Quantara Backend (DEVELOPMENT, VPS port 3002)
# Salin ke `.env` di /opt/quantara-dev/be pada VPS development.
# Generate secrets: openssl rand -hex 48 (JWT) | openssl rand -hex 32 (ENCRYPTION_KEY)
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL="postgresql://quantara_dev:GANTI_PASSWORD@127.0.0.1:5432/bot_trading_development?schema=public"

JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_48"
JWT_REFRESH_SECRET="GANTI_DENGAN_HASIL_BERBEDA_openssl_rand_hex_48"
ENCRYPTION_KEY="GANTI_DENGAN_HASIL_openssl_rand_hex_32"
ADMIN_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_24"

NODE_ENV="production"
APP_ENV="development"
PORT=3002
HOST="0.0.0.0"

CORS_ORIGINS="https://dev.quantara.software"
TRUST_PROXY_HOPS=1

# Public URL of the frontend — used in verification & password-reset links in emails.
APP_URL="https://dev.quantara.software"

# Email (WAJIB untuk verifikasi akun & reset password — jangan pakai # di depan baris aktif)
# Gmail: buat App Password di Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="notifications@yourdomain.com"
EMAIL_PASS="your-16-char-app-password"

ALLOWED_EXCHANGES=bitget,okx,binance

# Dev stack: dry-run / backtest only — avoid live bots on shared VPS RAM
# Default bot mode remains Dry Run via UI; do not enable mass live bots here.
GROK_CONFIRM_ENABLED=false
RAG_BACKTEST_ENABLED=true
BACKTEST_ISOLATE=1
BACKTEST_WORKER_HEAP_MB=512
BACKTEST_MAX_CONCURRENT=1
MEM_DEBUG=0
